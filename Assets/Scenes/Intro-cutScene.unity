  m_EditorClassIdentifier: Assembly-CSharp::CutsceneNarration
  lines:
  - "\uB3C4\uC2DC\uB294 \uBE5B\uC744 \uC0BC\uCF1C \uD0DC\uC5B4\uB0AC\uACE0,\n\uBE5B\uC774
    \uB9C8\uB974\uC790 \uC2A4\uC2A4\uB85C\uB97C \uC0BC\uD0A4\uAE30 \uC2DC\uC791\uD588\uB2E4."
  - "\uBD88\uC774 \uAEBC\uC9C4 \uC790\uB9AC\uB9C8\uB2E4 \uBD80\uC2A4\uB7EC\uAE30\uAC00
    \uB0A8\uC558\uB2E4."
  - "\uC0AC\uB78C\uB4E4\uC740 \uADF8\uAC83\uC744 \uC794\uC7AC\uB77C \uBD88\uB800\uB2E4."
  - "\uC794\uC7AC\uB294 \uBE5B\uC744 \uD749\uB0B4 \uB0B8\uB2E4."
  - "\uC0BC\uD0A4\uBA74 \uC7A0\uC2DC, \uC0B4\uC544 \uC788\uB294 \uAE30\uBD84\uC774
    \uB4E0\uB2E4."
  - "\uB108\uBB34 \uB9CE\uC774 \uC0BC\uD0A8 \uC790\uB294 \uBE5B\uC774 \uB418\uC5B4
    \uC0AC\uB77C\uC84C\uACE0,"
  - "\uD558\uB098\uB3C4 \uC0BC\uD0A4\uC9C0 \uBABB\uD55C \uC790\uB294 \uC9D0\uC2B9\uC774
    \uB418\uC5B4 \uB0A8\uC558\uB2E4."
  - "\uC794\uC7AC\uB97C \uBA39\uB294 \uC790\uB294 \uACB0\uAD6D \uC794\uC7AC\uAC00
    \uB41C\uB2E4."
  - "\uB098\uB294 \uADF8 \uC0AC\uC2E4\uC744 \uC54C\uBA74\uC11C \uB5A8\uC5B4\uC84C\uB2E4."
  target: {fileID: 409609764}
  waitFor: {fileID: 711420852}
